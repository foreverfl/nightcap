{
  "categories": [
    { "title": "## 🚀 Features",      "rules": [{ "pattern": "^feat(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## 🐛 Bug Fixes",     "rules": [{ "pattern": "^(bug|fix)(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## 📝 Documentation", "rules": [{ "pattern": "^(docs|dcos)(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## ♻️ Refactoring",   "rules": [{ "pattern": "^refactor(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## ⚡ Performance",    "rules": [{ "pattern": "^perf(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## 🔧 Maintenance",   "rules": [{ "pattern": "^chore(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## 🧪 Tests",         "rules": [{ "pattern": "^test(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] },
    { "title": "## 🔬 Spikes",        "rules": [{ "pattern": "^spike(\\(.*\\))?:", "flags": "gui", "on_property": "title" }] }
  ],
  "template": "#{{CHANGELOG}}\n#{{UNCATEGORIZED}}\n\n**Full Changelog**: #{{RELEASE_DIFF}}",
  "commit_template": "- #{{TITLE}} (#{{MERGE_SHA}})",
  "empty_template": "- No changes",
  "uncategorized_title": "## 🗂 Other"
}
